{
  "manifest_version": 3,
  "name": "YouTube Video Rotation",
  "version": "1.0.0",
  "description": "Rotate YouTube videos in 90° steps from the player controls.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
